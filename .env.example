# Copy this file to .env and fill in the values.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional: questions per user per minute (admins are never limited, 0 = no limit).
# The admin can also change it on the Admin page while the app runs.
CHAT_MAX_QUESTIONS_PER_MINUTE=5

POSTGRES_DB=cyberlaw
POSTGRES_USER=cyberlaw
POSTGRES_PASSWORD=cyberlaw_dev_password
POSTGRES_PORT=5432

# Required. Use your own values: the app does not start without them.
JWT_SECRET=CHANGE_ME_long_random_string_at_least_32_characters
ADMIN_EMAIL=admin@cyberlaw.az
ADMIN_PASSWORD=CHANGE_ME
